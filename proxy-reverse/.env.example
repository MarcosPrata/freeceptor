# Freeceptor Reverse Proxy Configuration

# Port where the proxy will listen locally
LOCAL_PORT=8080

# URL of your Freeceptor backend server
FREECEPTOR_URL=https://freeceptor.example.com

# Server name in Freeceptor (creates namespace for your logs)
SERVER_NAME=my-project

# Optional: Password for the server (if configured in Freeceptor)
SERVER_PASSWORD=

# Target URL: The real API that requests will be forwarded to
TARGET_URL=https://api.example.com

# Enable verbose logging
VERBOSE=false
