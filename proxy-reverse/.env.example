# Freeceptor Reverse Proxy Agent Configuration

# Unique identifier for this client (auto-generated if not set)
CLIENT_ID=

# Human-readable name for this client (shown in frontend)
CLIENT_NAME=my-machine

# URL of your Freeceptor backend server
FREECEPTOR_URL=https://freeceptor.example.com

# Server name in Freeceptor (creates namespace)
SERVER_NAME=my-project

# Optional: Password for the server (if configured in Freeceptor)
SERVER_PASSWORD=

# Local services to expose (format: name:port or name:host:port, comma-separated)
# Example: api:3000,postgres:5432,redis:localhost:6379
LOCAL_SERVICES=api:3000

# Enable verbose logging
VERBOSE=false

# Reconnect interval in milliseconds
RECONNECT_INTERVAL=5000
